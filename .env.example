# ─────────────────────────────────────────────────────────────
#  Copia este archivo como .env para personalizar (opcional).
#  Si no existe .env, se usan estos mismos valores por defecto.
# ─────────────────────────────────────────────────────────────

# Puertos en tu PC (cámbialos si ya están ocupados)
WP_PORT=8080
PMA_PORT=8081
MAIL_PORT=8025

# Sitio
SITE_TITLE="WP Elementor Local"
ADMIN_USER=admin
ADMIN_PASS=admin
ADMIN_EMAIL=admin@example.com
WP_LOCALE=es_ES
WP_TIMEZONE=America/Bogota

# Elementor siempre se instalan.
EXTRA_PLUGINS=""

# Pon "true" para instalar WooCommerce ya configurado
ENABLE_WOOCOMMERCE=false

# Base de datos
DB_NAME=wordpress
DB_USER=wp
DB_PASSWORD=wp
DB_ROOT_PASSWORD=root
